<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextArea?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="660.0" prefWidth="900.0" styleClass="LPbackground" stylesheets="@LPcss.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.typingapppro.QuickTestController">
    <top>
        <VBox alignment="CENTER" prefHeight="132.0" prefWidth="900.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <ImageView fitHeight="48.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@/appLogo.png" />
                            </image>
                            <cursor>
                                <Cursor fx:constant="DEFAULT" />
                            </cursor>
                        </ImageView>
                        <Label text=" TypeFaster" textFill="WHITE">
                            <font>
                                <Font size="35.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <Label fx:id="timeLabel" alignment="CENTER" text="00:00" textFill="WHITE">
                    <font>
                        <Font size="51.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>

    <bottom>
        <StackPane prefHeight="115.0" prefWidth="900.0" style="-fx-background-color: eee;" BorderPane.alignment="CENTER">
            <children>
                <JFXButton fx:id="abortButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onAction="#goToMainPage" prefHeight="46.0" prefWidth="127.0" styleClass="backspace" stylesheets="@tutorial.css" text="Abort Test">
               <StackPane.margin>
                  <Insets bottom="50.0" />
               </StackPane.margin></JFXButton>
            </children>
        </StackPane>
    </bottom>

    <left>
        <VBox alignment="CENTER" prefWidth="115.0" style="-fx-background-color: eee;" BorderPane.alignment="CENTER">
            <children>
                <JFXButton fx:id="resultButton" mnemonicParsing="false" onAction="#switchSceneToResult" opacity="0.0" text="GoToResult" />
            </children>
        </VBox>
    </left>

    <right>
        <VBox alignment="CENTER" prefWidth="124.0" style="-fx-background-color: eee;" BorderPane.alignment="CENTER">
            <children>
                <JFXButton fx:id="timerButton" mnemonicParsing="false" opacity="0.0" text="timerSOS" />
            </children>
        </VBox>
    </right>

    <center>
        <StackPane style="-fx-background-color: eee;" BorderPane.alignment="CENTER">
            <children>
                <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="403.0" prefWidth="660.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #AAA; -fx-border-radius: 20;">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="49.0" styleClass="testBlockHbox">
                            <children>
                                <Label text=" 1:00 Typing Test" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                    <padding>
                                        <Insets left="15.0" />
                                    </padding>
                                </Label>
                                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <ImageView fx:id="refreshButton" fitHeight="27.0" fitWidth="25.0" onMouseClicked="#restartTest" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@/refresh.png" />
                                            </image>
                                            <HBox.margin>
                                                <Insets right="15.0" />
                                            </HBox.margin>
                                        </ImageView>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                        <JFXTextArea fx:id="textDisplay" editable="false" focusColor="#405aa800" prefHeight="359.0" prefWidth="658.0" style="-fx-background-radius: 20; -fx-background-color: white;" unFocusColor="#4d4d4d00">
                            <font>
                                <Font size="19.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </JFXTextArea>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
