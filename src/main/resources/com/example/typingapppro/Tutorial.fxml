                        <JFXButton fx:id="r" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="R" textFill="WHITE" />
                        <JFXButton fx:id="t" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="T" textFill="WHITE" />
                        <JFXButton fx:id="y" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="Y" textFill="WHITE" />
