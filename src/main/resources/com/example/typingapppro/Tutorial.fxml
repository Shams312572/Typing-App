                        <JFXButton fx:id="keyBackslash" buttonType="RAISED" prefHeight="54.0" prefWidth="58.0" styleClass="keyboardButton" text="|&#10;\" textFill="WHITE" />

                        <JFXButton fx:id="capslock" buttonType="RAISED" prefHeight="54.0" prefWidth="92.0" styleClass="keyboardButton" text="Caps Lock" textFill="WHITE" />
                        <JFXButton fx:id="a" buttonType="RAISED" prefHeight="54.0" prefWidth="59.0" styleClass="homeKeys" text="A" textFill="WHITE" />
                        <JFXButton fx:id="s" buttonType="RAISED" prefHeight="54.0" prefWidth="59.0" styleClass="homeKeys" text="S" textFill="WHITE" />
                        <JFXButton fx:id="d" buttonType="RAISED" prefHeight="54.0" prefWidth="59.0" styleClass="homeKeys" text="D" textFill="WHITE" />
