                        <JFXButton fx:id="key7" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="&amp;&#10;7" textFill="WHITE" />
                        <JFXButton fx:id="key8" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="*&#10;8" textFill="WHITE" />
                        <JFXButton fx:id="key9" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="(&#10;9" textFill="WHITE" />
                        <JFXButton fx:id="key0" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text=")&#10;0" textFill="WHITE" />
                        <JFXButton fx:id="keyminus" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="-&#10;-" textFill="WHITE" />
                        <JFXButton fx:id="keyplus" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="+&#10;=" textFill="WHITE" />
                        <JFXButton fx:id="backspace" buttonType="RAISED" prefHeight="54.0" prefWidth="108.0" styleClass="backspace" text="Backspace" textFill="WHITE" />

                        <JFXButton fx:id="tab" buttonType="RAISED" prefHeight="54.0" prefWidth="79.0" styleClass="keyboardButton" text="Tab" textFill="WHITE" />
                        <JFXButton fx:id="q" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="Q" textFill="WHITE" />
                        <JFXButton fx:id="w" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="W" textFill="WHITE" />
