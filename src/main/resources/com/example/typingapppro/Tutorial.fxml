                        <JFXButton fx:id="key2" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="\@&#10;2" textFill="WHITE" />
                        <JFXButton fx:id="key3" buttonType="RAISED" prefHeight="54.0" prefWidth="57.0" styleClass="keyboardButton" text="#&#10;3" textFill="WHITE" />
