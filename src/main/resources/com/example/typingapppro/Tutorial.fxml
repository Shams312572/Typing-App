    <bottom>
        <StackPane prefHeight="178.0" prefWidth="950.0" BorderPane.alignment="CENTER">
            <children>
                <JFXButton fx:id="goToResultBtn" onAction="#switchSceneToResultPage" opacity="0.0" text="Button" visible="false" />
                <JFXButton fx:id="timerButton" opacity="0.0" text="Button" visible="false" />
                <JFXButton fx:id="HomeButton" alignment="TOP_CENTER" buttonType="RAISED" onAction="#goHome" prefHeight="40.0" prefWidth="150.0" styleClass="HomeButton" text="Home" textFill="#7b4b4b">
               <font>
                  <Font size="19.0" />
               </font>
               <StackPane.margin>
                  <Insets bottom="100.0" />
               </StackPane.margin></JFXButton>
            </children>
        </StackPane>
    </bottom>
</BorderPane>
