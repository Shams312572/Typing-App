                        <JFXButton fx:id="n" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="N" textFill="WHITE" />
                        <JFXButton fx:id="m" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="M" textFill="WHITE" />
                        <JFXButton fx:id="keyComma" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="&lt;&#10;," textFill="WHITE" />
                        <JFXButton fx:id="keyDot" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="&gt;&#10;." textFill="WHITE" />
                        <JFXButton fx:id="keyForwardslash" buttonType="RAISED" prefHeight="54.0" prefWidth="60.0" styleClass="keyboardButton" text="?&#10;/" textFill="WHITE" />
                        <JFXButton fx:id="shiftr" buttonType="RAISED" prefHeight="54.0" prefWidth="139.0" styleClass="greenKeys" text="Shift" textFill="WHITE" />

                        <JFXButton fx:id="ctrll" buttonType="RAISED" prefHeight="54.0" prefWidth="80.0" styleClass="blueKeys" text="Ctrl" textFill="WHITE" />
                        <JFXButton fx:id="altl" buttonType="RAISED" prefHeight="54.0" prefWidth="80.0" styleClass="blueKeys" text="Alt" textFill="WHITE" />
                        <JFXButton fx:id="space" buttonType="RAISED" prefHeight="54.0" prefWidth="500.0" styleClass="keyboardButton" text=" " textFill="WHITE" />
                        <JFXButton fx:id="altr" buttonType="RAISED" prefHeight="54.0" prefWidth="80.0" styleClass="blueKeys" text="Alt" textFill="WHITE" />
                        <JFXButton fx:id="ctrlr" buttonType="RAISED" prefHeight="54.0" prefWidth="80.0" styleClass="blueKeys" text="Ctrl" textFill="WHITE" />
                    </children>
                </FlowPane>
            </children>
        </VBox>
